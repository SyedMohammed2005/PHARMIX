generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  password  String
  role      UserRole @default(PHARMACIST)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  auditLogs             AuditLog[]
  notifications         Notification[]
  medicineSubstitutions MedicineSubstitution[]
}

model AuditLog {
  id String @id @default(cuid())

  userId String?
  action AuditAction

  entity   String
  entityId String?

  description String?

  beforeData Json?
  afterData  Json?

  ipAddress String?
  userAgent String?

  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([action])
  @@index([entity])
  @@index([entityId])
  @@index([createdAt])
}

model Notification {
  id String @id @default(cuid())

  userId   String?
  type     NotificationType
  severity NotificationSeverity

  title   String
  message String

  entity   String?
  entityId String?

  isRead Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([type])
  @@index([severity])
  @@index([isRead])
  @@index([createdAt])
  @@index([entity])
  @@index([entityId])
}

enum AuditAction {
  LOGIN
  LOGOUT

  CREATE
  UPDATE
  DELETE

  STOCK_ADJUSTMENT

  SALE_CREATED
  SALE_RETURNED
  SALE_REFUNDED

  PURCHASE_CREATED
  PURCHASE_RETURNED

  BATCH_CREATED
  BATCH_UPDATED

  ROLE_CHANGED
}

model Inventory {
  id           String             @id @default(cuid())
  productId    String             @unique
  quantity     Int                @default(0)
  minimumStock Int                @default(10)
  maximumStock Int?
  reorderPoint Int                @default(10)
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  product      Product            @relation(fields: [productId], references: [id])
  transactions StockTransaction[]
}

model Category {
  id          String    @id @default(cuid())
  name        String    @unique
  description String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  products    Product[]
}

model Supplier {
  id        String     @id @default(cuid())
  name      String
  email     String?    @unique
  phone     String?
  address   String?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  products  Product[]
  purchases Purchase[]
}

model Customer {
  id        String   @id @default(cuid())
  name      String
  phone     String?  @unique
  email     String?  @unique
  address   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  sales     Sale[]
}

model Sale {
  id            String       @id @default(cuid())
  invoiceNumber String       @unique
  customerId    String?
  subtotal      Float
  discount      Float        @default(0)
  tax           Float        @default(0)
  totalAmount   Float
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  payment       Payment?
  customer      Customer?    @relation(fields: [customerId], references: [id])
  items         SaleItem[]
  returns       SaleReturn[]

  @@index([customerId])
  @@index([createdAt])
}

model SaleReturn {
  id           String       @id @default(cuid())
  returnNumber String       @unique
  saleId       String
  totalRefund  Float
  reason       String?
  status       ReturnStatus @default(COMPLETED)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  items        ReturnItem[]
  sale         Sale         @relation(fields: [saleId], references: [id])

  @@index([saleId])
  @@index([createdAt])
}

model SaleItem {
  id        String       @id @default(cuid())
  saleId    String
  productId String
  batchId   String
  quantity  Int
  unitPrice Float
  gst       Float        @default(0)
  subtotal  Float
  createdAt DateTime     @default(now())
  returns   ReturnItem[]
  batch     Batch        @relation(fields: [batchId], references: [id])
  product   Product      @relation(fields: [productId], references: [id])
  sale      Sale         @relation(fields: [saleId], references: [id], onDelete: Cascade)

  @@index([saleId])
  @@index([productId])
  @@index([batchId])
}

model ReturnItem {
  id           String     @id @default(cuid())
  returnId     String
  saleItemId   String
  quantity     Int
  refundAmount Float
  createdAt    DateTime   @default(now())
  return       SaleReturn @relation(fields: [returnId], references: [id], onDelete: Cascade)
  saleItem     SaleItem   @relation(fields: [saleItemId], references: [id])

  @@index([returnId])
  @@index([saleItemId])
}

model Payment {
  id             String        @id @default(cuid())
  saleId         String        @unique
  amount         Float
  method         PaymentMethod
  status         PaymentStatus @default(COMPLETED)
  transactionId  String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  refundedAmount Float         @default(0)
  sale           Sale          @relation(fields: [saleId], references: [id], onDelete: Cascade)

  @@index([method])
  @@index([status])
}

model Product {
  id                         String                 @id @default(cuid())
  name                       String
  genericName                String?
  brand                      String?
  sku                        String                 @unique
  barcode                    String?                @unique
  purchasePrice              Float
  sellingPrice               Float
  mrp                        Float
  gst                        Float                  @default(0)
  requiresPrescription       Boolean                @default(false)
  categoryId                 String
  supplierId                 String
  createdAt                  DateTime               @default(now())
  updatedAt                  DateTime               @updatedAt
  batches                    Batch[]
  inventory                  Inventory?
  category                   Category               @relation(fields: [categoryId], references: [id])
  supplier                   Supplier               @relation(fields: [supplierId], references: [id])
  purchaseItems              PurchaseItem[]
  saleItems                  SaleItem[]
  medicineInformation        MedicineInformation?
  alternativeFor             MedicineAlternative[]  @relation("AlternativeSource")
  alternatives               MedicineAlternative[]  @relation("AlternativeTarget")
  substitutionsAsSource      MedicineSubstitution[] @relation("SubstitutionSource")
  substitutionsAsAlternative MedicineSubstitution[] @relation("SubstitutionAlternative")

  @@index([categoryId])
  @@index([supplierId])
}

model MedicineSubstitution {
  id                   String   @id @default(cuid())
  sourceProductId      String
  alternativeProductId String
  pharmacistId         String
  reason               String?
  status               String   @default("CONFIRMED")
  confirmedAt          DateTime @default(now())
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  sourceProduct Product @relation("SubstitutionSource", fields: [sourceProductId], references: [id], onDelete: Restrict)

  alternativeProduct Product @relation("SubstitutionAlternative", fields: [alternativeProductId], references: [id], onDelete: Restrict)

  pharmacist User @relation(fields: [pharmacistId], references: [id], onDelete: Restrict)

  @@index([sourceProductId])
  @@index([alternativeProductId])
  @@index([pharmacistId])
  @@index([status])
}

model MedicineAlternative {
  id                   String   @id @default(cuid())
  sourceProductId      String
  alternativeProductId String
  reason               String?
  isActive             Boolean  @default(true)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  sourceProduct Product @relation("AlternativeSource", fields: [sourceProductId], references: [id], onDelete: Cascade)

  alternativeProduct Product @relation("AlternativeTarget", fields: [alternativeProductId], references: [id], onDelete: Cascade)

  @@unique([sourceProductId, alternativeProductId])
  @@index([sourceProductId])
  @@index([alternativeProductId])
  @@index([isActive])
}

model MedicineInformation {
  id        String @id @default(cuid())
  productId String @unique

  dosageForm          String?
  strength            String?
  drugClass           String?
  therapeuticCategory String?

  uses                    String?
  precautions             String?
  sideEffects             String?
  storageInformation      String?
  prescriptionInformation String?

  verifiedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  product    Product             @relation(fields: [productId], references: [id], onDelete: Cascade)
  references MedicineReference[]

  @@index([drugClass])
  @@index([therapeuticCategory])
}

model MedicineReference {
  id                    String @id @default(cuid())
  medicineInformationId String

  sourceName String
  sourceType String
  sourceUrl  String?
  accessedAt DateTime @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  medicineInformation MedicineInformation @relation(fields: [medicineInformationId], references: [id], onDelete: Cascade)

  @@index([medicineInformationId])
  @@index([sourceType])
}

model Batch {
  id              String         @id @default(cuid())
  batchNumber     String         @unique
  productId       String
  manufactureDate DateTime
  expiryDate      DateTime
  quantity        Int            @default(0)
  purchasePrice   Float
  sellingPrice    Float
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  product         Product        @relation(fields: [productId], references: [id])
  purchaseItems   PurchaseItem[]
  saleItems       SaleItem[]

  @@index([productId])
  @@index([expiryDate])
}

model StockTransaction {
  id          String               @id @default(cuid())
  inventoryId String
  type        StockTransactionType
  quantity    Int
  reason      String?
  createdAt   DateTime             @default(now())
  inventory   Inventory            @relation(fields: [inventoryId], references: [id])

  @@index([inventoryId])
  @@index([type])
}

model Purchase {
  id             String           @id @default(cuid())
  purchaseNumber String           @unique
  supplierId     String
  subtotal       Float
  discount       Float            @default(0)
  tax            Float            @default(0)
  totalAmount    Float
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  supplier       Supplier         @relation(fields: [supplierId], references: [id])
  items          PurchaseItem[]
  payment        PurchasePayment?
  returns        PurchaseReturn[]

  @@index([supplierId])
  @@index([createdAt])
}

model PurchaseReturn {
  id           String               @id @default(cuid())
  returnNumber String               @unique
  purchaseId   String
  totalRefund  Float
  reason       String?
  status       ReturnStatus         @default(COMPLETED)
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt
  purchase     Purchase             @relation(fields: [purchaseId], references: [id])
  items        PurchaseReturnItem[]

  @@index([purchaseId])
  @@index([createdAt])
}

model PurchaseReturnItem {
  id             String         @id @default(cuid())
  returnId       String
  purchaseItemId String
  quantity       Int
  refundAmount   Float
  createdAt      DateTime       @default(now())
  purchaseItem   PurchaseItem   @relation(fields: [purchaseItemId], references: [id])
  return         PurchaseReturn @relation(fields: [returnId], references: [id], onDelete: Cascade)

  @@index([returnId])
  @@index([purchaseItemId])
}

model PurchaseItem {
  id          String               @id @default(cuid())
  purchaseId  String
  productId   String
  batchId     String
  quantity    Int
  unitPrice   Float
  gst         Float                @default(0)
  subtotal    Float
  createdAt   DateTime             @default(now())
  batch       Batch                @relation(fields: [batchId], references: [id])
  product     Product              @relation(fields: [productId], references: [id])
  purchase    Purchase             @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  returnItems PurchaseReturnItem[]

  @@index([purchaseId])
  @@index([productId])
  @@index([batchId])
}

model PurchasePayment {
  id            String        @id @default(cuid())
  purchaseId    String        @unique
  amount        Float
  method        PaymentMethod
  status        PaymentStatus @default(COMPLETED)
  transactionId String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  purchase      Purchase      @relation(fields: [purchaseId], references: [id], onDelete: Cascade)

  @@index([method])
  @@index([status])
}

enum UserRole {
  ADMIN
  PHARMACIST
  INVENTORY_MANAGER
  BUSINESS_ANALYST
}

enum PaymentMethod {
  CASH
  CARD
  UPI
  ONLINE
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

enum ReturnStatus {
  COMPLETED
  CANCELLED
}

enum StockTransactionType {
  PURCHASE
  SALE
  RETURN
  DAMAGE
  ADJUSTMENT
}

enum NotificationType {
  LOW_STOCK
  STOCKOUT_RISK
  EXPIRY_RISK
  DEMAND_SPIKE
  DEMAND_DROP
  WEATHER_SIGNAL
  FORECAST_UPDATE
  PURCHASE_ALERT
  SUPPLIER_ALERT
  AUDIT_ALERT
  AI_INSIGHT
  SYSTEM
}

enum NotificationSeverity {
  CRITICAL
  WARNING
  INFO
  SUCCESS
}
